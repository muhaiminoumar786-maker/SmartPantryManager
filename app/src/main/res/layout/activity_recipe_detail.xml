<?xml version="1.0" encoding="utf-8"?>

<!--Creating a scrollable layout for the recipe details screen-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--Creating the main recipe details layout-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!--Creating and styling the recipe name-->
        <TextView
            android:id="@+id/txtRecipeDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Recipe Name"
            android:textAlignment="center"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!--Creating and styling the recipe description-->
        <TextView
            android:id="@+id/txtRecipeDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:text="Recipe Description"
            android:textAlignment="center"
            android:textSize="16sp" />

        <!--Creating and styling the ingredients heading-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!--Creating the text used to display the required ingredients-->
        <TextView
            android:id="@+id/txtRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:lineSpacingExtra="6dp"
            android:text="Recipe ingredients"
            android:textSize="17sp" />

        <!--Creating and styling the instructions heading-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!--Creating the text used to display the instructions-->
        <TextView
            android:id="@+id/txtRecipeInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:lineSpacingExtra="5dp"
            android:text="Recipe instructions"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>